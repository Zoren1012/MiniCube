{
  "schemaVersion": 1,
  "id": "minicube-hud",
  "version": "${version}",
  "name": "MiniCube HUD",
  "description": "Un affichage discret en jeu : coordonnees, direction, images par seconde, latence, heure et serveur. Aux couleurs de MiniCube.",
  "authors": ["Zoren1012"],
  "contact": {
    "homepage": "https://github.com/Zoren1012/MiniCube",
    "sources": "https://github.com/Zoren1012/MiniCube"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["fr.minicube.hud.MiniCubeHudClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
